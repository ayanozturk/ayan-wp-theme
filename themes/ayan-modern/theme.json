{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "ink",
					"color": "#0B0B0C",
					"name": "Ink"
				},
				{
					"slug": "paper",
					"color": "#F3F4F6",
					"name": "Paper"
				},
				{
					"slug": "mute",
					"color": "#6B7280",
					"name": "Mute"
				},
				{
					"slug": "signal",
					"color": "#BE123C",
					"name": "Signal"
				},
				{
					"slug": "line",
					"color": "#E5E7EB",
					"name": "Line"
				},
				{
					"slug": "white",
					"color": "#FFFFFF",
					"name": "White"
				}
			]
		},
		"layout": {
			"contentSize": "42rem",
			"wideSize": "72rem"
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "2"
				},
				{
					"slug": "30",
					"size": "0.75rem",
					"name": "3"
				},
				{
					"slug": "40",
					"size": "1rem",
					"name": "4"
				},
				{
					"slug": "50",
					"size": "1.5rem",
					"name": "5"
				},
				{
					"slug": "60",
					"size": "2rem",
					"name": "6"
				},
				{
					"slug": "70",
					"size": "3rem",
					"name": "7"
				},
				{
					"slug": "80",
					"size": "4.5rem",
					"name": "8"
				}
			],
			"units": ["%", "px", "em", "rem", "vh", "vw"]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Syne\", sans-serif",
					"name": "Syne",
					"slug": "syne",
					"fontFace": [
						{
							"fontFamily": "Syne",
							"fontWeight": "400 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/syne/Syne-Variable.woff2"]
						}
					]
				},
				{
					"fontFamily": "\"Source Sans 3\", sans-serif",
					"name": "Source Sans 3",
					"slug": "source-sans-3",
					"fontFace": [
						{
							"fontFamily": "Source Sans 3",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/source-sans-3/SourceSans3-Variable.woff2"]
						},
						{
							"fontFamily": "Source Sans 3",
							"fontWeight": "400 700",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/source-sans-3/SourceSans3-Italic-Variable.woff2"]
						}
					]
				},
				{
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
					"name": "System Mono",
					"slug": "mono"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small",
					"fluid": {
						"min": "0.8125rem",
						"max": "0.875rem"
					}
				},
				{
					"slug": "medium",
					"size": "1.125rem",
					"name": "Medium",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "large",
					"size": "1.5rem",
					"name": "Large",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"size": "2.25rem",
					"name": "Extra Large",
					"fluid": {
						"min": "1.75rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "xx-large",
					"size": "3.5rem",
					"name": "2X Large",
					"fluid": {
						"min": "2.25rem",
						"max": "3.5rem"
					}
				}
			]
		},
		"border": {
			"radius": true
		},
		"custom": {
			"radius": {
				"editorial": "2px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--source-sans-3)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--50)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--50)"
			},
			"blockGap": "1.5rem"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--signal)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--signal)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--syne)",
					"fontWeight": "700",
					"lineHeight": "1.15"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"button": {
				"border": {
					"radius": "2px"
				},
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--paper)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--syne)",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--signal)",
						"text": "var(--wp--preset--color--white)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--mute)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--syne)",
					"fontWeight": "700",
					"lineHeight": "1.1"
				}
			},
			"core/post-content": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-sans-3)",
					"lineHeight": "1.7"
				},
				"spacing": {
					"blockGap": "1.25rem"
				}
			},
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "var(--wp--preset--color--ink)",
							"style": "solid",
							"width": "1px",
							"radius": "2px"
						},
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--ink)"
						}
					}
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "0.75rem"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--syne)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"core/query": {
				"spacing": {
					"blockGap": "2rem"
				}
			},
			"core/cover": {
				"color": {
					"text": "var(--wp--preset--color--paper)"
				},
				"dimensions": {
					"minHeight": "70vh"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--70)",
						"right": "var(--wp--preset--spacing--50)",
						"bottom": "var(--wp--preset--spacing--70)",
						"left": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"core/separator": {
				"color": {
					"background": "var(--wp--preset--color--line)"
				},
				"border": {
					"color": "var(--wp--preset--color--line)"
				}
			},
			"core/quote": {
				"border": {
					"color": "var(--wp--preset--color--signal)",
					"style": "solid",
					"width": "0 0 0 3px"
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--50)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-sans-3)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "blank",
			"title": "Blank",
			"postTypes": ["page", "post"]
		}
	]
}
